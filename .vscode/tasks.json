{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-main",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-g",
        "src/main.cpp",
        "src/astar.cpp",
        "src/telemetry.cpp",
        "src/sort_utils.cpp",
        "src/hashmap.cpp",
        "Mapping/2D_gridnew.cpp",
        "NFZ/NFZ_AVL.cpp",
        "HazardDetectionUpdated/HazardDetector.cpp",
        "-Iinclude",
        "-IMapping",
        "-IHazardDetectionUpdated",
        "-o",
        "main.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc"
    },
    {
      "type": "cppbuild",
      "label": "C/C++: g++.exe build active file",
      "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-std=c++17",
        "-g",
        "-I${workspaceFolder}\\include",
        "-I${workspaceFolder}\\Mapping",
        "-I${workspaceFolder}\\HazardDetectionUpdated",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Task generated by Debugger."
    }
  ]
}

